        {
            "@type": "DataDownload",
            "name": "PDMS_characterization.zip",
            "encodingFormat": "application/zip",
            "contentSize": 14460,
            "description": "This folder contains the codes used for characterizing the PDMS membranes under equibiaxial strain.\n 'align_images_manually': a semi-automatic code where the user clicks on the same point of the image in each frame so that all the frames are aligned on that point; helpful for a better automatic image registration later;\n 'tilt_correction': a code to transform a 3D image into a 2D image to correct for the tilt of the membrane in the stretcher;\n 'strain_analysis:' image registration and calculation of the strain for each characterization experiment.",
            "@id": "https://doi.org/10.25625/MDCE31/V1GZA9",
            "identifier": "https://doi.org/10.25625/MDCE31/V1GZA9",
